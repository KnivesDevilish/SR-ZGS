# SR-ZGS — files that must never be committed.
# This repository is public. Game data, and anything derived from it,
# stays local. These rules are a safety net, not a guarantee.

# --- Game dumps and extracted game data ---------------------------------------
/iso/
/extracted/
*.iso
*.wbfs
*.rvz
*.wia
*.gcz
*.ciso
*.dol
*.rel

# --- Generated recompiled code (derived from the game executable) -------------
/generated/

# --- Build output -------------------------------------------------------------
/build/
build-*/
cmake-build-*/
CMakeUserPresets.json
.cache/

# --- Object files and binaries ------------------------------------------------
*.o
*.a
*.so
*.bc

# --- Editors ------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- Operating system ---------------------------------------------------------
.DS_Store
Thumbs.db
